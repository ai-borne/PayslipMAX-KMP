default_platform(:ios)

platform :ios do
  desc "Authenticate against the App Store Connect API (no Apple ID/password prompts)"
  lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["ASC_KEY_FILEPATH"]),
      in_house: false
    )
  end

  desc "Show App Store version review status (e.g. v1.1.1 In Review / Approved / Rejected)"
  lane :review_status do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    versions = app.get_app_store_versions(includes: "appStoreVersionSubmission")
    versions.first(5).each do |v|
      UI.message("v#{v.version_string} — #{v.app_store_state}")
    end
  end

  desc "List current TestFlight builds and their processing/review state"
  lane :testflight_builds do
    asc_api_key
    builds = Spaceship::ConnectAPI::Build.all(
      app_id: Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)).id
    )
    builds.first(10).each do |b|
      UI.message("#{b.version} (#{b.app_version}) — processing: #{b.processing_state}")
    end
  end

  desc "Authenticate against the App Store Connect API with the Finance-scoped key (Sales/Trends Reports only)"
  private_lane :asc_finance_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_FINANCE_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["ASC_FINANCE_KEY_FILEPATH"]),
      in_house: false
    )
  end

  desc "Print daily install/download units for the last N days (default 30) from Sales Reports"
  lane :install_counts do |options|
    require 'net/http'
    require 'uri'
    require 'zlib'
    require 'stringio'

    days = (options[:days] || 30).to_i
    vendor_number = ENV["ASC_VENDOR_NUMBER"]
    UI.user_error!("Set ASC_VENDOR_NUMBER in fastlane/.env") if vendor_number.nil? || vendor_number.empty?

    asc_finance_key
    token = Spaceship::ConnectAPI.token.text

    total_installs = 0
    (0...days).each do |offset|
      date = (Date.today - offset).strftime("%Y-%m-%d")
      uri = URI("https://api.appstoreconnect.apple.com/v1/salesReports")
      uri.query = URI.encode_www_form(
        "filter[reportType]" => "SALES",
        "filter[reportSubType]" => "SUMMARY",
        "filter[frequency]" => "DAILY",
        "filter[version]" => "1_0",
        "filter[vendorNumber]" => vendor_number,
        "filter[reportDate]" => date
      )
      res = Net::HTTP.get_response(uri, { "Authorization" => "Bearer #{token}" })
      next unless res.code == "200"

      tsv = Zlib::GzipReader.new(StringIO.new(res.body)).read
      rows = tsv.lines.map { |l| l.chomp.split("\t") }
      header = rows.shift
      units_idx = header.index("Units")
      type_idx = header.index("Product Type Identifier")

      day_installs = rows.select { |r| %w[1 1F 1T].include?(r[type_idx]) }
                          .sum { |r| r[units_idx].to_i }
      total_installs += day_installs
      UI.message("#{date}: #{day_installs} new installs") if day_installs > 0
    end

    UI.success("Total new installs over last #{days} days: #{total_installs}")
  end

  desc "Show the app's subscription groups, their localizations, and each subscription's state"
  lane :subscription_status do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    groups = asc_get("/v1/apps/#{app.id}/subscriptionGroups")["data"] || []
    UI.user_error!("No subscription groups found for this app") if groups.empty?

    groups.each do |g|
      UI.message("group #{g['id']} — referenceName: #{g['attributes']['referenceName']}")
      locs = asc_get("/v1/subscriptionGroups/#{g['id']}/subscriptionGroupLocalizations")["data"] || []
      if locs.empty?
        UI.important("  group localizations: NONE — submission will be blocked")
      else
        locs.each { |l| UI.success("  group localization #{l['attributes']['locale']}: name=#{l['attributes']['name']} state=#{l['attributes']['state']}") }
      end
      subs = asc_get("/v1/subscriptionGroups/#{g['id']}/subscriptions")["data"] || []
      subs.each { |s| UI.message("  subscription #{s['attributes']['productId']} — state: #{s['attributes']['state']}") }
    end
  end

  desc "Create a subscription-group localization (required before a subscription can be submitted)"
  lane :add_subscription_group_localization do |options|
    asc_api_key
    group_id = options[:group_id] or UI.user_error!("Pass group_id:")
    name = options[:name] or UI.user_error!("Pass name: (the group display name users see)")
    locale = options[:locale] || "en-US"

    body = {
      "data" => {
        "type" => "subscriptionGroupLocalizations",
        "attributes" => { "name" => name, "locale" => locale },
        "relationships" => {
          "subscriptionGroup" => { "data" => { "type" => "subscriptionGroups", "id" => group_id.to_s } }
        }
      }
    }
    res = asc_post("/v1/subscriptionGroupLocalizations", body)
    UI.success("Created group localization #{locale}: #{res['data']['attributes']['name']} (state: #{res['data']['attributes']['state']})")
  end

  # --- raw App Store Connect API helpers (spaceship has no model for subscription groups) ---

  def asc_request(method, path, body = nil)
    require 'net/http'
    require 'uri'
    require 'json'
    uri = URI("https://api.appstoreconnect.apple.com#{path}")
    req_class = { post: Net::HTTP::Post, patch: Net::HTTP::Patch, get: Net::HTTP::Get, delete: Net::HTTP::Delete }.fetch(method)
    req = req_class.new(uri)
    req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
    req["Content-Type"] = "application/json"
    req.body = body.to_json if body
    res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.request(req) }
    parsed = res.body.to_s.empty? ? {} : JSON.parse(res.body)
    unless res.code.to_i.between?(200, 299)
      errors = (parsed["errors"] || []).map { |e| "#{e['title']}: #{e['detail']}" }.join("; ")
      UI.user_error!("ASC API #{method.to_s.upcase} #{path} failed (#{res.code}): #{errors}")
    end
    parsed
  end

  def asc_get(path)
    asc_request(:get, path)
  end

  def asc_post(path, body)
    asc_request(:post, path, body)
  end

  def asc_patch(path, body)
    asc_request(:patch, path, body)
  end

  def asc_delete(path)
    asc_request(:delete, path)
  end

  desc "Delete every screenshot in an appScreenshotSet (e.g. to clear stale screenshots ASC auto-copies from the previous version onto a newly created one before uploading fresh ones)"
  lane :clear_screenshot_set do |options|
    asc_api_key
    set_id = options[:set_id] or UI.user_error!("Pass set_id: (an appScreenshotSets id, from asc_raw path:\"/v1/appStoreVersionLocalizations/<loc_id>/appScreenshotSets\")")
    shots = asc_get("/v1/appScreenshotSets/#{set_id}/appScreenshots")["data"] || []
    UI.user_error!("No screenshots found in set #{set_id}") if shots.empty?
    shots.each do |s|
      asc_delete("/v1/appScreenshots/#{s['id']}")
      UI.message("Deleted #{s['attributes']['fileName']} (#{s['id']})")
    end
    UI.success("Cleared #{shots.count} screenshots from set #{set_id}")
  end

  desc "Open a new, editable App Store version (PREPARE_FOR_SUBMISSION) — does NOT submit for review. Needed because a TestFlight upload alone does not create an appStoreVersions object; App Name/Subtitle/Keywords/Description edits require one to exist in an editable state."
  lane :create_app_store_version do |options|
    asc_api_key
    version_string = options[:version] or UI.user_error!("Pass version: e.g. '1.2.2'")
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))

    existing = (asc_get("/v1/apps/#{app.id}/appStoreVersions?limit=10")["data"] || []).find { |v| v['attributes']['versionString'] == version_string }
    if existing
      UI.important("appStoreVersion #{version_string} already exists (state: #{existing['attributes']['appVersionState']}) — no change made")
      next
    end

    body = {
      "data" => {
        "type" => "appStoreVersions",
        "attributes" => { "platform" => "IOS", "versionString" => version_string },
        "relationships" => { "app" => { "data" => { "type" => "apps", "id" => app.id } } }
      }
    }
    res = asc_post("/v1/appStoreVersions", body)
    UI.success("Created appStoreVersion #{version_string} (id #{res['data']['id']}, state: #{res['data']['attributes']['appVersionState']})")
  end

  desc "Dry-run diff (default) or apply (apply:true) the queued relaunch ASO copy — App Name/Subtitle/Keywords/Description — from docs/Launch/09_testersCommunityreport.md onto the current (latest) editable App Store version. Never submits for review."
  lane :apply_relaunch_aso_copy do |options|
    asc_api_key
    locale = options[:locale] || "en-US"
    apply = options[:apply] == true || options[:apply] == "true"

    new_name = "PayslipMax: Payslip Manager"
    new_subtitle = "Salary, Tax & DSOP Insights"
    new_keywords = "payslip,salary,payslip manager,tax planner,dsop,army,payslip parser,income tax,salary tracker"
    new_description = <<~DESC.strip
      PayslipMax is a privacy-first, on-device salary and payslip management application designed to help PCDA(O) users to understand earnings, verify deductions, and optimize tax savings with total security.

      100% ON-DEVICE PRIVACY, ZERO CLOUD UPLOADS
      Your payslips never leave your phone. All PDF parsing, salary computations, and AI insights are performed locally on your device with zero server uploads. Nothing is sent to any server, ever.

      KEY FEATURES

      Smart Payslip Parsing
      - Instantly read and parse complex PCDA(O) payslip PDFs with high accuracy.
      - Automatically organize earnings (Basic Pay, DA, HRA, Allowances) and deductions (DSOP, Taxes, AGIF, Arrears etc).
      - Interactive digital replica viewer to inspect and audit your original payslip layout, line by line.

      In-Depth Salary Breakdown and Trends
      - Track month-over-month income variations, net salary growth, and deduction changes over your entire service.
      - Visual charts for earnings vs. deductions distribution, so you can see exactly where your money goes.
      - Intelligent Anomaly Detection automatically flags a missing allowance or an unexpected deduction spike.

      Intelligent Tax and Savings Calculators
      - Compare Old vs. New Tax Regimes with accurate, updated slabs for the current financial year.
      - Calculate income tax liabilities, standard deductions, and 80C/80D investment impacts.
      - DSOP Wealth Simulator: project your retirement fund growth with interactive interest projections, compounding curves, and custom contribution scenarios.

      Private On-Device AI Insights
      - Contextual analysis of salary components and personalized tax optimization opportunities.
      - Powered by on-device intelligence, with your private financial data never shared with third parties.

      Security You Can Trust
      - Secure local biometric or PIN app lock protection.
      - No account registration or external tracking required.
      - AES-256 encryption for all stored payslip data.

      WHO PAYSLIPMAX IS FOR
      PayslipMax is built for serving PCDA(O)-administered users who want clarity on their pay without handing financial documents to a third-party service. It is equally useful for:
      - A user posted to a new unit who wants to quickly confirm a changed allowance or HRA slab is reflected correctly.
      - Personnel comparing DSOP balances month over month ahead of retirement planning.
      - Anyone deciding between the Old and New Tax Regime who wants a clear estimate based on their own payslip figures rather than generic examples.
      - Families who track household salary trends but do not want payslip PDFs stored in email or cloud drives.

      FREQUENTLY ASKED QUESTIONS

      Is my payslip data uploaded anywhere?
      No. PayslipMax parses your PDF entirely on your device. No payslip, PDF, or extracted salary figure is ever uploaded to a server.

      Which payslip formats are supported?
      PayslipMax is purpose-built for PCDA(O) payslip formats and is regularly updated as formats change across statement periods.

      Which tax regimes are supported?
      Both the Old and New Tax Regimes are supported, with slabs kept current for the applicable financial year.

      Do I need an account to use the app?
      No account or sign-in is required. Your data stays on your device, tied to your device alone.

      What if the app misreads a value from my payslip?
      You can review and correct any parsed field directly in the app; your correction is saved without altering the original parsed document.

      PayslipMax Premium is an auto-renewing subscription; see Terms of Use and Privacy Policy for billing and cancellation details.

      Terms of Use (EULA): https://www.apple.com/legal/internet-services/itunes/dev/stdeula/
    DESC

    UI.user_error!("App Name exceeds 30 chars (#{new_name.length})") if new_name.length > 30
    UI.user_error!("Subtitle exceeds 30 chars (#{new_subtitle.length})") if new_subtitle.length > 30
    UI.user_error!("Keywords exceed 100 chars (#{new_keywords.length})") if new_keywords.length > 100
    UI.user_error!("Description exceeds 4000 chars (#{new_description.length})") if new_description.length > 4000

    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))

    info = (asc_get("/v1/apps/#{app.id}/appInfos")["data"] || []).find { |i| i['attributes']['appStoreState'] != 'READY_FOR_SALE' } ||
           (asc_get("/v1/apps/#{app.id}/appInfos")["data"] || []).first
    UI.user_error!("No appInfo found") unless info
    info_locs = asc_get("/v1/appInfos/#{info['id']}/appInfoLocalizations")["data"] || []
    info_loc = info_locs.find { |l| l['attributes']['locale'] == locale }
    UI.user_error!("No #{locale} appInfoLocalization found") unless info_loc

    version = (asc_get("/v1/apps/#{app.id}/appStoreVersions?limit=10")["data"] || []).find { |v| v['attributes']['appVersionState'] != 'READY_FOR_SALE' && v['attributes']['appVersionState'] != 'READY_FOR_DISTRIBUTION' }
    UI.user_error!("No editable app store version found — run create_app_store_version version:'x.y.z' first") unless version
    version_locs = asc_get("/v1/appStoreVersions/#{version['id']}/appStoreVersionLocalizations")["data"] || []
    version_loc = version_locs.find { |l| l['attributes']['locale'] == locale }
    UI.user_error!("No #{locale} appStoreVersionLocalization found") unless version_loc

    UI.message("--- Target: appInfo #{info['id']} (#{info['attributes']['appStoreState']}), appStoreVersion #{version['attributes']['versionString']} (#{version['attributes']['appVersionState']}) ---")
    UI.message("App Name:    #{info_loc['attributes']['name'].inspect} -> #{new_name.inspect}")
    UI.message("Subtitle:    #{info_loc['attributes']['subtitle'].inspect} -> #{new_subtitle.inspect}")
    UI.message("Keywords:    #{version_loc['attributes']['keywords'].inspect} -> #{new_keywords.inspect}")
    UI.message("Description: (#{version_loc['attributes']['description'].to_s.length} chars) -> (#{new_description.length} chars)")

    unless apply
      UI.important("Dry run only — pass apply:true to write these changes")
      next
    end

    asc_patch("/v1/appInfoLocalizations/#{info_loc['id']}", {
      "data" => { "type" => "appInfoLocalizations", "id" => info_loc['id'], "attributes" => { "name" => new_name, "subtitle" => new_subtitle } }
    })
    asc_patch("/v1/appStoreVersionLocalizations/#{version_loc['id']}", {
      "data" => { "type" => "appStoreVersionLocalizations", "id" => version_loc['id'], "attributes" => { "keywords" => new_keywords, "description" => new_description } }
    })
    UI.success("Applied relaunch ASO copy to #{locale}")
  end

  desc "Show the full App Store listing: App Name/Subtitle (appInfo) + Keywords/Description/Promotional Text (version)"
  lane :ios_listing_status do |options|
    asc_api_key
    locale = options[:locale] || "en-US"
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))

    infos = asc_get("/v1/apps/#{app.id}/appInfos")["data"] || []
    infos.each do |info|
      UI.message("--- appInfo #{info['id']} — state: #{info['attributes']['appStoreState']} ---")
      locs = asc_get("/v1/appInfos/#{info['id']}/appInfoLocalizations")["data"] || []
      loc = locs.find { |l| l['attributes']['locale'] == locale }
      if loc
        UI.message("  App Name: #{loc['attributes']['name']}")
        UI.message("  Subtitle: #{loc['attributes']['subtitle']}")
      else
        UI.important("  no #{locale} appInfoLocalization found")
      end
    end

    version = asc_get("/v1/apps/#{app.id}/appStoreVersions?limit=3")["data"].first
    UI.user_error!("No app store version found") unless version
    UI.message("--- appStoreVersion #{version['attributes']['versionString']} — state: #{version['attributes']['appVersionState']} ---")
    vlocs = asc_get("/v1/appStoreVersions/#{version['id']}/appStoreVersionLocalizations")["data"] || []
    vloc = vlocs.find { |l| l['attributes']['locale'] == locale }
    if vloc
      UI.message("  Keywords: #{vloc['attributes']['keywords']}")
      UI.message("  Promotional Text: #{vloc['attributes']['promotionalText']}")
      UI.message("  Description:")
      UI.message(vloc['attributes']['description'])
    else
      UI.important("  no #{locale} appStoreVersionLocalization found")
    end
  end

  desc "Update Promotional Text on the current (live) App Store version (docs/Launch/09_testersCommunityreport.md SSOT relaunch — the one version-scoped field Apple allows editing without a new build/review)"
  lane :update_promotional_text do |options|
    asc_api_key
    locale = options[:locale] || "en-US"
    new_promo_text = "Turn your PCDA(O) payslip into clear salary, tax and DSOP insights, 100% on-device."
    UI.user_error!("Promotional text would exceed ASC's 170-char limit (#{new_promo_text.length})") if new_promo_text.length > 170

    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    version = asc_get("/v1/apps/#{app.id}/appStoreVersions?limit=3")["data"].first
    UI.user_error!("No app store version found") unless version
    locs = asc_get("/v1/appStoreVersions/#{version['id']}/appStoreVersionLocalizations")["data"] || []
    loc = locs.find { |l| l['attributes']['locale'] == locale }
    UI.user_error!("No #{locale} localization found") unless loc

    if loc['attributes']['promotionalText'] == new_promo_text
      UI.important("Promotional text already up to date — no change made")
      next
    end

    body = {
      "data" => {
        "type" => "appStoreVersionLocalizations",
        "id" => loc['id'],
        "attributes" => { "promotionalText" => new_promo_text }
      }
    }
    res = asc_patch("/v1/appStoreVersionLocalizations/#{loc['id']}", body)
    UI.success("Promotional text updated for #{locale}: #{res['data']['attributes']['promotionalText']}")
  end

  desc "Show the current App Store version's Description localization (for the rejected-version EULA-link fix)"
  lane :app_description do |options|
    asc_api_key
    locale = options[:locale] || "en-US"
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    version = asc_get("/v1/apps/#{app.id}/appStoreVersions?limit=3")["data"].first
    UI.user_error!("No app store version found") unless version
    UI.message("version #{version['attributes']['versionString']} — state: #{version['attributes']['appVersionState']}")
    locs = asc_get("/v1/appStoreVersions/#{version['id']}/appStoreVersionLocalizations")["data"] || []
    loc = locs.find { |l| l['attributes']['locale'] == locale }
    UI.user_error!("No #{locale} localization found") unless loc
    UI.message("localization id: #{loc['id']}")
    UI.message("--- description ---")
    UI.message(loc['attributes']['description'])
  end

  desc "Append the standard Apple EULA link to the App Description (Guideline 3.1.2 metadata fix)"
  lane :add_eula_link_to_description do |options|
    asc_api_key
    locale = options[:locale] || "en-US"
    eula_url = "https://www.apple.com/legal/internet-services/itunes/dev/stdeula/"
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    version = asc_get("/v1/apps/#{app.id}/appStoreVersions?limit=3")["data"].first
    UI.user_error!("No app store version found") unless version
    locs = asc_get("/v1/appStoreVersions/#{version['id']}/appStoreVersionLocalizations")["data"] || []
    loc = locs.find { |l| l['attributes']['locale'] == locale }
    UI.user_error!("No #{locale} localization found") unless loc

    current = loc['attributes']['description'].to_s
    if current.include?(eula_url)
      UI.important("EULA link already present in description — no change made")
      next
    end

    updated = "#{current}\n\nTerms of Use (EULA): #{eula_url}"
    UI.user_error!("Updated description would exceed ASC's 4000-char limit (#{updated.length})") if updated.length > 4000

    body = {
      "data" => {
        "type" => "appStoreVersionLocalizations",
        "id" => loc['id'],
        "attributes" => { "description" => updated }
      }
    }
    res = asc_patch("/v1/appStoreVersionLocalizations/#{loc['id']}", body)
    UI.success("Description updated for #{locale}. New length: #{res['data']['attributes']['description'].length}")
  end

  desc "Show one subscription's localizations and price points (diagnosing MISSING_METADATA)"
  lane :subscription_detail do |options|
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    groups = asc_get("/v1/apps/#{app.id}/subscriptionGroups")["data"] || []
    groups.each do |g|
      subs = asc_get("/v1/subscriptionGroups/#{g['id']}/subscriptions")["data"] || []
      subs.each do |s|
        UI.message("subscription #{s['id']} #{s['attributes']['productId']} — state=#{s['attributes']['state']} name=#{s['attributes']['name']} period=#{s['attributes']['subscriptionPeriod']}")
        locs = asc_get("/v1/subscriptions/#{s['id']}/subscriptionLocalizations")["data"] || []
        locs.each { |l| UI.success("  loc #{l['attributes']['locale']}: name=#{l['attributes']['name']} desc=#{l['attributes']['description']} state=#{l['attributes']['state']}") }
        prices = asc_get("/v1/subscriptions/#{s['id']}/prices?limit=5")["data"] || []
        UI.message("  price entries: #{prices.length}")
        avail = asc_get("/v1/subscriptions/#{s['id']}/availability") rescue nil
        UI.message("  availability: #{avail && avail['data'] ? avail['data']['attributes'] : 'none'}")
      end
    end
  end

  desc "Raw GET against any ASC API path (debugging)"
  lane :asc_raw do |options|
    asc_api_key
    require 'json'
    UI.message(JSON.pretty_generate(asc_get(options[:path])))
  end

  desc "Copy captioned screenshot PNGs from a source folder into fastlane/screenshots/<locale>/ (dry-run staging step before upload_screenshots — Priority 2 screenshot redo, docs/Launch/09_testersCommunityreport.md)"
  lane :stage_screenshots do |options|
    require 'fileutils'
    locale = options[:locale] || "en-US"
    source = options[:source] or UI.user_error!("Pass source: (folder of captioned PNGs; numeric filename prefixes set upload order)")
    dest = File.join(File.dirname(__FILE__), "screenshots", locale)
    FileUtils.mkdir_p(dest)
    files = Dir.glob(File.join(source, "*.png")).sort
    UI.user_error!("No PNGs found in #{source}") if files.empty?
    files.each { |f| FileUtils.cp(f, dest) }
    UI.success("Staged #{files.count} screenshots into #{dest}")
    files.each { |f| UI.message("  #{File.basename(f)}") }
  end

  desc "Upload staged screenshots directly via Spaceship::ConnectAPI::AppScreenshot (bypasses deliver's UploadScreenshots — its folder/device-type auto-detection silently uploaded nothing against this project's flat locale folder, twice, with no error). Run stage_screenshots first."
  lane :upload_screenshots_direct do |options|
    asc_api_key
    locale = options[:locale] || "en-US"
    display_type = options[:display_type] || "APP_IPHONE_65"
    dir = File.join(File.dirname(__FILE__), "screenshots", locale)
    files = Dir.glob(File.join(dir, "*.png")).sort
    UI.user_error!("No screenshots staged at #{dir} — run stage_screenshots first") if files.empty?

    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    version = (asc_get("/v1/apps/#{app.id}/appStoreVersions?limit=10")["data"] || []).find { |v| !["READY_FOR_SALE", "READY_FOR_DISTRIBUTION"].include?(v['attributes']['appVersionState']) }
    UI.user_error!("No editable app store version found — run create_app_store_version first") unless version
    vlocs = asc_get("/v1/appStoreVersions/#{version['id']}/appStoreVersionLocalizations")["data"] || []
    vloc = vlocs.find { |l| l['attributes']['locale'] == locale }
    UI.user_error!("No #{locale} appStoreVersionLocalization found") unless vloc
    sets = asc_get("/v1/appStoreVersionLocalizations/#{vloc['id']}/appScreenshotSets")["data"] || []
    set = sets.find { |s| s['attributes']['screenshotDisplayType'] == display_type }
    UI.user_error!("No #{display_type} appScreenshotSet found for #{locale}") unless set

    existing = asc_get("/v1/appScreenshotSets/#{set['id']}/appScreenshots")["data"] || []
    if existing.any?
      UI.important("#{existing.count} screenshots already in #{display_type} — deleting before re-upload")
      existing.each { |s| asc_delete("/v1/appScreenshots/#{s['id']}") }
    end

    files.each do |f|
      UI.message("Uploading #{File.basename(f)}...")
      Spaceship::ConnectAPI::AppScreenshot.create(app_screenshot_set_id: set['id'], path: f, wait_for_processing: true)
    end
    UI.success("Uploaded #{files.count} screenshots to #{display_type} (#{locale}) on appStoreVersion #{version['attributes']['versionString']}")
  end

  desc "DEPRECATED — deliver's UploadScreenshots silently uploads nothing against this project's flat-locale screenshots folder (confirmed twice: logs 'success' but ASC shows 0 files). Use upload_screenshots_direct instead. Left here for reference only."
  lane :upload_screenshots do |options|
    asc_api_key
    locale = options[:locale] || "en-US"
    dir = File.join(File.dirname(__FILE__), "screenshots", locale)
    UI.user_error!("No screenshots staged at #{dir} — run stage_screenshots first") unless Dir.exist?(dir) && Dir.glob("#{dir}/*.png").any?

    deliver(
      screenshots_path: File.join(File.dirname(__FILE__), "screenshots"),
      skip_screenshots: false,
      skip_metadata: true,
      skip_binary_upload: true,
      skip_app_version_update: true,
      run_precheck_before_submit: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true,
      use_live_version: true
    )
    UI.success("Uploaded #{Dir.glob("#{dir}/*.png").count} screenshots for #{locale}")
  end

  desc "Bump build number, archive, and upload a new TestFlight build (does NOT touch marketing version — pass bump_version: '1.2.2' to also change it for a real new App Store submission)"
  lane :build_and_upload_testflight do |options|
    asc_api_key

    xcodeproj = File.expand_path(File.join(File.dirname(__FILE__), "..", "iosApp.xcodeproj"))

    # Scoped to the iosApp target only — the plain increment_build_number/increment_version_number
    # actions shell out to `agvtool ... -all`, which stamps every target uniformly (including
    # PayslipMaxTests) and would silently clobber the app target's own build number.
    require 'xcodeproj'
    project = Xcodeproj::Project.open(xcodeproj)
    app_target = project.targets.find { |t| t.name == "iosApp" } or UI.user_error!("Target 'iosApp' not found in #{xcodeproj}")

    current_build = app_target.build_configurations.first.build_settings["CURRENT_PROJECT_VERSION"].to_i
    new_build = current_build + 1

    app_target.build_configurations.each do |config|
      config.build_settings["CURRENT_PROJECT_VERSION"] = new_build.to_s
      config.build_settings["MARKETING_VERSION"] = options[:bump_version] if options[:bump_version]
    end
    project.save
    UI.important("Building iosApp — build #{new_build}#{options[:bump_version] ? " (version #{options[:bump_version]})" : ""}")

    build_app(
      project: xcodeproj,
      scheme: "iosApp",
      export_method: "app-store",
      output_directory: File.expand_path(File.join(File.dirname(__FILE__), "builds")),
      clean: true
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      changelog: options[:changelog] || "Internal build — see docs/Launch/06_closed_testing_progress_log.md"
    )

    UI.success("Uploaded build #{new_build} to TestFlight")
  end

  desc "Fill in everything an editable App Store version needs before review: attach build, What's New, review notes. Reads fastlane/release_notes/<version>/{whats_new,review_notes}.txt. Pass version:, build:. Does NOT submit."
  lane :prepare_submission do |options|
    asc_api_key
    version_string = options[:version] or UI.user_error!("Pass version: e.g. '1.2.2'")
    build_number = options[:build].to_s
    UI.user_error!("Pass build: e.g. 7") if build_number.empty?
    dir = File.join(__dir__, "release_notes", version_string)
    whats_new = File.read(File.join(dir, "whats_new.txt")).strip
    review_notes = File.read(File.join(dir, "review_notes.txt")).strip

    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    version = (asc_get("/v1/apps/#{app.id}/appStoreVersions?limit=10")["data"] || []).find { |v| v['attributes']['versionString'] == version_string }
    UI.user_error!("No appStoreVersion #{version_string}; run create_app_store_version first") unless version
    UI.user_error!("#{version_string} is #{version['attributes']['appVersionState']}, not editable") unless version['attributes']['appVersionState'] == "PREPARE_FOR_SUBMISSION"

    builds = asc_get("/v1/builds?filter[app]=#{app.id}&filter[preReleaseVersion.version]=#{version_string}&filter[version]=#{build_number}")["data"] || []
    UI.user_error!("Build #{version_string} (#{build_number}) not found in App Store Connect") if builds.empty?
    UI.user_error!("Build #{build_number} is #{builds[0]['attributes']['processingState']}, not VALID") unless builds[0]['attributes']['processingState'] == "VALID"
    asc_patch("/v1/appStoreVersions/#{version['id']}/relationships/build", { "data" => { "type" => "builds", "id" => builds[0]['id'] } })
    UI.success("Attached build #{build_number}")

    loc = asc_get("/v1/appStoreVersions/#{version['id']}/appStoreVersionLocalizations")["data"].find { |l| l['attributes']['locale'] == "en-US" }
    asc_patch("/v1/appStoreVersionLocalizations/#{loc['id']}", { "data" => { "type" => "appStoreVersionLocalizations", "id" => loc['id'], "attributes" => { "whatsNew" => whats_new } } })
    UI.success("Set What's New (#{whats_new.length} chars)")

    detail = asc_get("/v1/appStoreVersions/#{version['id']}/appStoreReviewDetail")["data"]
    asc_patch("/v1/appStoreReviewDetails/#{detail['id']}", { "data" => { "type" => "appStoreReviewDetails", "id" => detail['id'], "attributes" => { "notes" => review_notes } } })
    UI.success("Set review notes (#{review_notes.length} chars)")
  end

  desc "Submit an editable App Store version to App Review. Pass version:. Requires confirm:true — this is outward-facing and (releaseType AFTER_APPROVAL) auto-publishes on approval."
  lane :submit_for_review do |options|
    asc_api_key
    version_string = options[:version] or UI.user_error!("Pass version: e.g. '1.2.2'")
    UI.user_error!("Refusing to submit without confirm:true") unless options[:confirm].to_s == "true"

    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    version = (asc_get("/v1/apps/#{app.id}/appStoreVersions?limit=10")["data"] || []).find { |v| v['attributes']['versionString'] == version_string }
    UI.user_error!("No appStoreVersion #{version_string}") unless version
    UI.user_error!("#{version_string} is #{version['attributes']['appVersionState']}, not PREPARE_FOR_SUBMISSION") unless version['attributes']['appVersionState'] == "PREPARE_FOR_SUBMISSION"

    open = (asc_get("/v1/apps/#{app.id}/reviewSubmissions?filter[platform]=IOS&filter[state]=READY_FOR_REVIEW")["data"] || []).first
    submission = open || asc_post("/v1/reviewSubmissions", { "data" => { "type" => "reviewSubmissions", "attributes" => { "platform" => "IOS" }, "relationships" => { "app" => { "data" => { "type" => "apps", "id" => app.id } } } } })["data"]
    items = asc_get("/v1/reviewSubmissions/#{submission['id']}/items")["data"] || []
    if items.empty?
      asc_post("/v1/reviewSubmissionItems", { "data" => { "type" => "reviewSubmissionItems", "relationships" => {
        "reviewSubmission" => { "data" => { "type" => "reviewSubmissions", "id" => submission['id'] } },
        "appStoreVersion" => { "data" => { "type" => "appStoreVersions", "id" => version['id'] } } } } })
    end
    res = asc_patch("/v1/reviewSubmissions/#{submission['id']}", { "data" => { "type" => "reviewSubmissions", "id" => submission['id'], "attributes" => { "submitted" => true } } })
    UI.success("Submitted #{version_string} — reviewSubmission state: #{res['data']['attributes']['state']}")
  end

  desc "Upload dSYMs to Firebase Crashlytics (fixes 'Missing dSYM' emails). Pass dsym_path: for a specific .xcarchive/.dSYM, or omit to auto-download the latest build's dSYMs from App Store Connect"
  lane :upload_dsyms do |options|
    # Crashlytics is SPM-managed (no Pods/), so the upload-symbols binary lives under the
    # resolved package checkout in DerivedData rather than at a fixed repo-relative path.
    binary = Dir.glob(File.expand_path("~/Library/Developer/Xcode/DerivedData/*/SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols")).first
    UI.user_error!("Could not find Firebase's upload-symbols binary under DerivedData — build the project in Xcode first to resolve SPM packages") unless binary

    if options[:dsym_path]
      upload_symbols_to_crashlytics(
        dsym_path: options[:dsym_path],
        gsp_path: "iosApp/GoogleService-Info.plist",
        binary_path: binary
      )
    else
      asc_api_key
      download_dsyms(version: options[:version], build_number: options[:build_number])
      upload_symbols_to_crashlytics(
        dsym_path: "./*.dSYM.zip",
        gsp_path: "iosApp/GoogleService-Info.plist",
        binary_path: binary
      )
      clean_build_artifacts
    end
    UI.success("dSYMs uploaded to Crashlytics")
  end

  desc "Show a subscription's current customer price per territory (defaults to the key ones)"
  lane :subscription_prices do |options|
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    want = (options[:territories] || "IND,USA,GBR").split(",")
    groups = asc_get("/v1/apps/#{app.id}/subscriptionGroups")["data"] || []
    groups.each do |g|
      subs = asc_get("/v1/subscriptionGroups/#{g['id']}/subscriptions")["data"] || []
      subs.each do |s|
        UI.message("#{s['attributes']['productId']} — state: #{s['attributes']['state']}")
        res = asc_get("/v1/subscriptions/#{s['id']}/prices?include=subscriptionPricePoint,territory&limit=200")
        points = (res["included"] || []).select { |i| i["type"] == "subscriptionPricePoints" }
                                        .each_with_object({}) { |i, h| h[i["id"]] = i["attributes"] }
        (res["data"] || []).each do |price|
          terr = price.dig("relationships", "territory", "data", "id")
          next unless want.include?(terr)
          pp = points[price.dig("relationships", "subscriptionPricePoint", "data", "id")] || {}
          UI.success("  #{terr}: customerPrice=#{pp['customerPrice']} proceeds=#{pp['proceeds']} startDate=#{price['attributes']['startDate'] || 'current'} preserved=#{price['attributes']['preserved']}")
        end
      end
    end
  end
end
