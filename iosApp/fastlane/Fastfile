default_platform(:ios)

platform :ios do
  desc "Authenticate against the App Store Connect API (no Apple ID/password prompts)"
  lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["ASC_KEY_FILEPATH"]),
      in_house: false
    )
  end

  desc "Show App Store version review status (e.g. v1.1.1 In Review / Approved / Rejected)"
  lane :review_status do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    versions = app.get_app_store_versions(includes: "appStoreVersionSubmission")
    versions.first(5).each do |v|
      UI.message("v#{v.version_string} — #{v.app_store_state}")
    end
  end

  desc "List current TestFlight builds and their processing/review state"
  lane :testflight_builds do
    asc_api_key
    builds = Spaceship::ConnectAPI::Build.all(
      app_id: Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)).id
    )
    builds.first(10).each do |b|
      UI.message("#{b.version} (#{b.app_version}) — processing: #{b.processing_state}")
    end
  end

  desc "Authenticate against the App Store Connect API with the Finance-scoped key (Sales/Trends Reports only)"
  private_lane :asc_finance_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_FINANCE_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["ASC_FINANCE_KEY_FILEPATH"]),
      in_house: false
    )
  end

  desc "Print daily install/download units for the last N days (default 30) from Sales Reports"
  lane :install_counts do |options|
    require 'net/http'
    require 'uri'
    require 'zlib'
    require 'stringio'

    days = (options[:days] || 30).to_i
    vendor_number = ENV["ASC_VENDOR_NUMBER"]
    UI.user_error!("Set ASC_VENDOR_NUMBER in fastlane/.env") if vendor_number.nil? || vendor_number.empty?

    asc_finance_key
    token = Spaceship::ConnectAPI.token.text

    total_installs = 0
    (0...days).each do |offset|
      date = (Date.today - offset).strftime("%Y-%m-%d")
      uri = URI("https://api.appstoreconnect.apple.com/v1/salesReports")
      uri.query = URI.encode_www_form(
        "filter[reportType]" => "SALES",
        "filter[reportSubType]" => "SUMMARY",
        "filter[frequency]" => "DAILY",
        "filter[version]" => "1_0",
        "filter[vendorNumber]" => vendor_number,
        "filter[reportDate]" => date
      )
      res = Net::HTTP.get_response(uri, { "Authorization" => "Bearer #{token}" })
      next unless res.code == "200"

      tsv = Zlib::GzipReader.new(StringIO.new(res.body)).read
      rows = tsv.lines.map { |l| l.chomp.split("\t") }
      header = rows.shift
      units_idx = header.index("Units")
      type_idx = header.index("Product Type Identifier")

      day_installs = rows.select { |r| %w[1 1F 1T].include?(r[type_idx]) }
                          .sum { |r| r[units_idx].to_i }
      total_installs += day_installs
      UI.message("#{date}: #{day_installs} new installs") if day_installs > 0
    end

    UI.success("Total new installs over last #{days} days: #{total_installs}")
  end

  desc "Show the app's subscription groups, their localizations, and each subscription's state"
  lane :subscription_status do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    groups = asc_get("/v1/apps/#{app.id}/subscriptionGroups")["data"] || []
    UI.user_error!("No subscription groups found for this app") if groups.empty?

    groups.each do |g|
      UI.message("group #{g['id']} — referenceName: #{g['attributes']['referenceName']}")
      locs = asc_get("/v1/subscriptionGroups/#{g['id']}/subscriptionGroupLocalizations")["data"] || []
      if locs.empty?
        UI.important("  group localizations: NONE — submission will be blocked")
      else
        locs.each { |l| UI.success("  group localization #{l['attributes']['locale']}: name=#{l['attributes']['name']} state=#{l['attributes']['state']}") }
      end
      subs = asc_get("/v1/subscriptionGroups/#{g['id']}/subscriptions")["data"] || []
      subs.each { |s| UI.message("  subscription #{s['attributes']['productId']} — state: #{s['attributes']['state']}") }
    end
  end

  desc "Create a subscription-group localization (required before a subscription can be submitted)"
  lane :add_subscription_group_localization do |options|
    asc_api_key
    group_id = options[:group_id] or UI.user_error!("Pass group_id:")
    name = options[:name] or UI.user_error!("Pass name: (the group display name users see)")
    locale = options[:locale] || "en-US"

    body = {
      "data" => {
        "type" => "subscriptionGroupLocalizations",
        "attributes" => { "name" => name, "locale" => locale },
        "relationships" => {
          "subscriptionGroup" => { "data" => { "type" => "subscriptionGroups", "id" => group_id.to_s } }
        }
      }
    }
    res = asc_post("/v1/subscriptionGroupLocalizations", body)
    UI.success("Created group localization #{locale}: #{res['data']['attributes']['name']} (state: #{res['data']['attributes']['state']})")
  end

  # --- raw App Store Connect API helpers (spaceship has no model for subscription groups) ---

  def asc_request(method, path, body = nil)
    require 'net/http'
    require 'uri'
    require 'json'
    uri = URI("https://api.appstoreconnect.apple.com#{path}")
    req_class = { post: Net::HTTP::Post, patch: Net::HTTP::Patch, get: Net::HTTP::Get }.fetch(method)
    req = req_class.new(uri)
    req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
    req["Content-Type"] = "application/json"
    req.body = body.to_json if body
    res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.request(req) }
    parsed = res.body.to_s.empty? ? {} : JSON.parse(res.body)
    unless res.code.to_i.between?(200, 299)
      errors = (parsed["errors"] || []).map { |e| "#{e['title']}: #{e['detail']}" }.join("; ")
      UI.user_error!("ASC API #{method.to_s.upcase} #{path} failed (#{res.code}): #{errors}")
    end
    parsed
  end

  def asc_get(path)
    asc_request(:get, path)
  end

  def asc_post(path, body)
    asc_request(:post, path, body)
  end

  def asc_patch(path, body)
    asc_request(:patch, path, body)
  end

  desc "Show the current App Store version's Description localization (for the rejected-version EULA-link fix)"
  lane :app_description do |options|
    asc_api_key
    locale = options[:locale] || "en-US"
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    version = asc_get("/v1/apps/#{app.id}/appStoreVersions?limit=3")["data"].first
    UI.user_error!("No app store version found") unless version
    UI.message("version #{version['attributes']['versionString']} — state: #{version['attributes']['appVersionState']}")
    locs = asc_get("/v1/appStoreVersions/#{version['id']}/appStoreVersionLocalizations")["data"] || []
    loc = locs.find { |l| l['attributes']['locale'] == locale }
    UI.user_error!("No #{locale} localization found") unless loc
    UI.message("localization id: #{loc['id']}")
    UI.message("--- description ---")
    UI.message(loc['attributes']['description'])
  end

  desc "Append the standard Apple EULA link to the App Description (Guideline 3.1.2 metadata fix)"
  lane :add_eula_link_to_description do |options|
    asc_api_key
    locale = options[:locale] || "en-US"
    eula_url = "https://www.apple.com/legal/internet-services/itunes/dev/stdeula/"
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    version = asc_get("/v1/apps/#{app.id}/appStoreVersions?limit=3")["data"].first
    UI.user_error!("No app store version found") unless version
    locs = asc_get("/v1/appStoreVersions/#{version['id']}/appStoreVersionLocalizations")["data"] || []
    loc = locs.find { |l| l['attributes']['locale'] == locale }
    UI.user_error!("No #{locale} localization found") unless loc

    current = loc['attributes']['description'].to_s
    if current.include?(eula_url)
      UI.important("EULA link already present in description — no change made")
      next
    end

    updated = "#{current}\n\nTerms of Use (EULA): #{eula_url}"
    UI.user_error!("Updated description would exceed ASC's 4000-char limit (#{updated.length})") if updated.length > 4000

    body = {
      "data" => {
        "type" => "appStoreVersionLocalizations",
        "id" => loc['id'],
        "attributes" => { "description" => updated }
      }
    }
    res = asc_patch("/v1/appStoreVersionLocalizations/#{loc['id']}", body)
    UI.success("Description updated for #{locale}. New length: #{res['data']['attributes']['description'].length}")
  end

  desc "Show one subscription's localizations and price points (diagnosing MISSING_METADATA)"
  lane :subscription_detail do |options|
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    groups = asc_get("/v1/apps/#{app.id}/subscriptionGroups")["data"] || []
    groups.each do |g|
      subs = asc_get("/v1/subscriptionGroups/#{g['id']}/subscriptions")["data"] || []
      subs.each do |s|
        UI.message("subscription #{s['id']} #{s['attributes']['productId']} — state=#{s['attributes']['state']} name=#{s['attributes']['name']} period=#{s['attributes']['subscriptionPeriod']}")
        locs = asc_get("/v1/subscriptions/#{s['id']}/subscriptionLocalizations")["data"] || []
        locs.each { |l| UI.success("  loc #{l['attributes']['locale']}: name=#{l['attributes']['name']} desc=#{l['attributes']['description']} state=#{l['attributes']['state']}") }
        prices = asc_get("/v1/subscriptions/#{s['id']}/prices?limit=5")["data"] || []
        UI.message("  price entries: #{prices.length}")
        avail = asc_get("/v1/subscriptions/#{s['id']}/availability") rescue nil
        UI.message("  availability: #{avail && avail['data'] ? avail['data']['attributes'] : 'none'}")
      end
    end
  end

  desc "Raw GET against any ASC API path (debugging)"
  lane :asc_raw do |options|
    asc_api_key
    require 'json'
    UI.message(JSON.pretty_generate(asc_get(options[:path])))
  end

  desc "Show a subscription's current customer price per territory (defaults to the key ones)"
  lane :subscription_prices do |options|
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    want = (options[:territories] || "IND,USA,GBR").split(",")
    groups = asc_get("/v1/apps/#{app.id}/subscriptionGroups")["data"] || []
    groups.each do |g|
      subs = asc_get("/v1/subscriptionGroups/#{g['id']}/subscriptions")["data"] || []
      subs.each do |s|
        UI.message("#{s['attributes']['productId']} — state: #{s['attributes']['state']}")
        res = asc_get("/v1/subscriptions/#{s['id']}/prices?include=subscriptionPricePoint,territory&limit=200")
        points = (res["included"] || []).select { |i| i["type"] == "subscriptionPricePoints" }
                                        .each_with_object({}) { |i, h| h[i["id"]] = i["attributes"] }
        (res["data"] || []).each do |price|
          terr = price.dig("relationships", "territory", "data", "id")
          next unless want.include?(terr)
          pp = points[price.dig("relationships", "subscriptionPricePoint", "data", "id")] || {}
          UI.success("  #{terr}: customerPrice=#{pp['customerPrice']} proceeds=#{pp['proceeds']} startDate=#{price['attributes']['startDate'] || 'current'} preserved=#{price['attributes']['preserved']}")
        end
      end
    end
  end
end
