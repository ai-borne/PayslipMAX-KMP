# Node / JS / Python environment
node_modules/
dist/
coverage/
.venv/

# Scan output
scripts/scan_rh_output.txt

# Firebase — only real secrets must be excluded
# google-services.json is safe to commit (contains only public app/project IDs,
# no private keys; consistent with Google Firebase docs and all quickstart repos)
# GoogleService-Info.plist excluded until iOS Firebase Auth is integrated (Phase 2-iOS)
GoogleService-Info.plist
functions/.env
functions/.secret.local
.firebaserc.local

# Contains real payslip PII; kept locally for opt-in dev/integration tests only
/payslips_data_standardized.json

# Python build artifacts
__pycache__/
*.pyc
/payslips_data.json

# Contains real payslip PII; local dev DB snapshots and debug logs, never committed
/payslips.db
/payslips_device.db
/docs/Plan/difflogandroid
/docs/Plan/difflogios

# Xcode & SwiftPM local user files
**/xcuserdata/
**/.swiftpm/

# Tier 6 Gemma base model binary (~529MB) — release-only Gradle task acquires it before
# bundleRelease; never committed (see gemmaModelPack/src/main/assets/PLACEHOLDER_*.txt)
gemmaModelPack/src/main/assets/*.litertlm

# Tier 6 Gemma base model binary, iOS On-Demand Resource (~557MB) — added locally in Xcode per
# developer machine (tagged "GemmaModel"), never committed; same reasoning as the Android path above
iosApp/iosApp/*.litertlm

iosApp/iosApp.xcodeproj/project.xcworkspace/contents.xcworkspacedata
iosApp/iosApp.xcodeproj/project.xcworkspace/xcuserdata/sunil.xcuserdatad/UserInterfaceState.xcuserstate
iosApp/iosApp.xcodeproj/project.xcworkspace/xcuserdata/sunil.xcuserdatad/UserInterfaceState.xcuserstate

# fastlane — App Store Connect API credentials and generated reports, never committed
# (the .p8 key itself lives outside the repo entirely, at ~/.appstoreconnect/private_keys/)
iosApp/fastlane/.env
iosApp/fastlane/report.xml
iosApp/fastlane/Preview.html
iosApp/fastlane/screenshots/
iosApp/fastlane/builds/
iosApp/fastlane/test_output/
iosApp/fastlane/README.md
*.p8

# Playwright MCP scratch output (e.g. composited marketing screenshots) — not source
.playwright-mcp/

# fastlane — Google Play Console API credentials, never committed
# (the service-account .json key itself lives outside the repo entirely, at ~/.play_console/)
composeApp/fastlane/.env
composeApp/fastlane/report.xml
composeApp/fastlane/README.md
*.play_console*.json
