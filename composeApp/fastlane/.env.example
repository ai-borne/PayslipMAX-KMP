# Copy to composeApp/fastlane/.env (git-ignored) and fill in real values.
# Never commit .env or the service-account .json key itself.

# Google Play Console service account (Play Console -> Users and permissions),
# scoped to: "View app information and download bulk reports (read-only)" (account-level)
# + "Manage store presence" (app-level, PayslipMax only). No release-management,
# financial, or order-management permissions.
PLAY_JSON_KEY_FILEPATH=~/.play_console/payslipmax-fastlane-supply.json
