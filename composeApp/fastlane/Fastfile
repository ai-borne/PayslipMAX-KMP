default_platform(:android)

platform :android do
  # Play Console edits require: create edit -> read/write listing -> commit (or delete to discard).
  # Reads use a throwaway edit that's deleted afterward, so a status check never mutates the live listing.
  def play_service
    require 'googleauth'
    require 'google/apis/androidpublisher_v3'

    key_path = File.expand_path(ENV["PLAY_JSON_KEY_FILEPATH"] || UI.user_error!("Set PLAY_JSON_KEY_FILEPATH in fastlane/.env"))
    UI.user_error!("Play Console key not found at #{key_path}") unless File.exist?(key_path)

    service = Google::Apis::AndroidpublisherV3::AndroidPublisherService.new
    service.authorization = Google::Auth::ServiceAccountCredentials.make_creds(
      json_key_io: File.open(key_path),
      scope: ["https://www.googleapis.com/auth/androidpublisher"]
    )
    service
  end

  def package_name
    CredentialsManager::AppfileConfig.try_fetch_value(:package_name)
  end

  desc "Show the current Play Store listing (title/short/full description) for a locale (default en-IN, this app's only listed locale)"
  lane :listing_status do |options|
    locale = options[:locale] || "en-IN"
    service = play_service
    edit = service.insert_edit(package_name)
    begin
      listing = service.get_edit_listing(package_name, edit.id, locale)
      UI.message("--- #{locale} title ---")
      UI.message(listing.title)
      UI.message("--- #{locale} short description ---")
      UI.message(listing.short_description)
      UI.message("--- #{locale} full description ---")
      UI.message(listing.full_description)
    rescue Google::Apis::ClientError => e
      UI.important("No #{locale} listing found: #{e.message}")
    ensure
      service.delete_edit(package_name, edit.id)
    end
  end

  desc "Append a subscription auto-renewal/terms disclosure line to the Play Store full description, if not already present"
  lane :add_terms_disclosure_to_listing do |options|
    locale = options[:locale] || "en-IN"
    disclosure = "PayslipMax Premium is an auto-renewing subscription; see Terms of Use and Privacy Policy for billing and cancellation details."

    service = play_service
    edit = service.insert_edit(package_name)

    listing = service.get_edit_listing(package_name, edit.id, locale)
    current = listing.full_description.to_s

    if current.include?(disclosure)
      UI.important("Disclosure already present in #{locale} full description — no change made")
      service.delete_edit(package_name, edit.id)
      next
    end

    updated = "#{current}\n\n#{disclosure}"
    if updated.length > 4000
      service.delete_edit(package_name, edit.id)
      UI.user_error!("Updated full description would exceed Play's 4000-char limit (#{updated.length})")
    end

    updated_listing = Google::Apis::AndroidpublisherV3::Listing.new(
      title: listing.title,
      short_description: listing.short_description,
      full_description: updated,
      video: listing.video
    )
    service.update_edit_listing(package_name, edit.id, locale, updated_listing)
    service.commit_edit(package_name, edit.id)
    UI.success("#{locale} full description updated and committed. New length: #{updated.length}")
  end

  desc "Apply the day-10 closed-testing ASO relaunch: new title + rewritten full description (see docs/Launch/09_testersCommunityreport.md)"
  lane :apply_aso_relaunch_listing do |options|
    locale = options[:locale] || "en-IN"
    new_title = "PayslipMax: Payslip Manager"
    new_full_description = <<~DESC.strip
      PayslipMax is a privacy-first, on-device salary and payslip management application designed to help PCDA(O) users to understand earnings, verify deductions, and optimize tax savings with total security.

      100% ON-DEVICE PRIVACY, ZERO CLOUD UPLOADS
      Your payslips never leave your phone. All PDF parsing, salary computations, and AI insights are performed locally on your device with zero server uploads. Nothing is sent to any server, ever.

      KEY FEATURES

      Smart Payslip Parsing
      - Instantly read and parse complex PCDA(O) payslip PDFs with high accuracy.
      - Automatically organize earnings (Basic Pay, DA, HRA, Allowances) and deductions (DSOP, Taxes, AGIF, Arrears etc).
      - Interactive digital replica viewer to inspect and audit your original payslip layout, line by line.

      In-Depth Salary Breakdown and Trends
      - Track month-over-month income variations, net salary growth, and deduction changes over your entire service.
      - Visual charts for earnings vs. deductions distribution, so you can see exactly where your money goes.
      - Intelligent Anomaly Detection automatically flags a missing allowance or an unexpected deduction spike.

      Intelligent Tax and Savings Calculators
      - Compare Old vs. New Tax Regimes with accurate, updated slabs for the current financial year.
      - Calculate income tax liabilities, standard deductions, and 80C/80D investment impacts.
      - DSOP Wealth Simulator: project your retirement fund growth with interactive interest projections, compounding curves, and custom contribution scenarios.

      Private On-Device AI Insights
      - Contextual analysis of salary components and personalized tax optimization opportunities.
      - Powered by on-device intelligence, with your private financial data never shared with third parties.

      Security You Can Trust
      - Secure local biometric or PIN app lock protection.
      - No account registration or external tracking required.
      - AES-256 encryption for all stored payslip data.

      WHO PAYSLIPMAX IS FOR
      PayslipMax is built for serving PCDA(O)-administered users who want clarity on their pay without handing financial documents to a third-party service. It is equally useful for:
      - A user posted to a new unit who wants to quickly confirm a changed allowance or HRA slab is reflected correctly.
      - Personnel comparing DSOP balances month over month ahead of retirement planning.
      - Anyone deciding between the Old and New Tax Regime who wants a clear estimate based on their own payslip figures rather than generic examples.
      - Families who track household salary trends but do not want payslip PDFs stored in email or cloud drives.

      FREQUENTLY ASKED QUESTIONS

      Is my payslip data uploaded anywhere?
      No. PayslipMax parses your PDF entirely on your device. No payslip, PDF, or extracted salary figure is ever uploaded to a server.

      Which payslip formats are supported?
      PayslipMax is purpose-built for PCDA(O) payslip formats and is regularly updated as formats change across statement periods.

      Which tax regimes are supported?
      Both the Old and New Tax Regimes are supported, with slabs kept current for the applicable financial year.

      Do I need an account to use the app?
      No account or sign-in is required. Your data stays on your device, tied to your device alone.

      What if the app misreads a value from my payslip?
      You can review and correct any parsed field directly in the app; your correction is saved without altering the original parsed document.

      PayslipMax Premium is an auto-renewing subscription; see Terms of Use and Privacy Policy for billing and cancellation details.
    DESC

    if new_title.length > 30
      UI.user_error!("New title would exceed Play's 30-char limit (#{new_title.length})")
    end
    if new_full_description.length > 4000
      UI.user_error!("New full description would exceed Play's 4000-char limit (#{new_full_description.length})")
    end

    service = play_service
    edit = service.insert_edit(package_name)
    listing = service.get_edit_listing(package_name, edit.id, locale)

    updated_listing = Google::Apis::AndroidpublisherV3::Listing.new(
      title: new_title,
      short_description: listing.short_description,
      full_description: new_full_description,
      video: listing.video
    )
    service.update_edit_listing(package_name, edit.id, locale, updated_listing)
    service.commit_edit(package_name, edit.id)
    UI.success("#{locale} listing updated and committed. Title: \"#{new_title}\" (#{new_title.length} chars). Full description length: #{new_full_description.length} chars")
  end

  desc "Show how many phone screenshots are currently live for a locale (read-only, uses a throwaway edit like listing_status)"
  lane :screenshot_status do |options|
    locale = options[:locale] || "en-IN"
    service = play_service
    edit = service.insert_edit(package_name)
    begin
      images = service.list_edit_images(package_name, edit.id, locale, "phoneScreenshots").images || []
      UI.message("#{locale} phoneScreenshots: #{images.count} live")
      images.each { |img| UI.message("  #{img.id} — #{img.url}") }
    rescue Google::Apis::ClientError => e
      UI.important("Could not list screenshots: #{e.message}")
    ensure
      service.delete_edit(package_name, edit.id)
    end
  end

  desc "Upload a built AAB to a Play Console track (default: internal). Pass aab: path to the bundle, track: internal|alpha|beta|production, and optionally notes: release notes text."
  lane :upload_to_track do |options|
    aab_path = options[:aab] or UI.user_error!("Pass aab: path to the .aab file")
    UI.user_error!("AAB not found at #{aab_path}") unless File.exist?(aab_path)
    track = options[:track] || "internal"

    service = play_service
    # AABs carrying the on-demand Gemma asset pack run 400MB+ — the gem's default HTTP timeouts
    # (well under a minute) are tuned for small JSON payloads, not a bundle this large.
    service.client_options.open_timeout_sec = 60
    service.client_options.send_timeout_sec = 1800
    service.client_options.read_timeout_sec = 1800
    edit = service.insert_edit(package_name)
    begin
      bundle = service.upload_edit_bundle(package_name, edit.id, upload_source: aab_path, content_type: "application/octet-stream")
      UI.message("Uploaded bundle, versionCode #{bundle.version_code}")

      release = Google::Apis::AndroidpublisherV3::TrackRelease.new(
        name: "versionCode #{bundle.version_code}",
        status: "completed",
        version_codes: [bundle.version_code.to_s],
        release_notes: options[:notes] ? [Google::Apis::AndroidpublisherV3::LocalizedText.new(language: options[:notes_locale] || "en-IN", text: options[:notes])] : nil
      )
      track_body = Google::Apis::AndroidpublisherV3::Track.new(track: track, releases: [release])
      service.update_edit_track(package_name, edit.id, track, track_body)

      service.commit_edit(package_name, edit.id)
      UI.success("versionCode #{bundle.version_code} released to #{track} track")
    rescue => e
      service.delete_edit(package_name, edit.id)
      detail = e.respond_to?(:body) ? " — #{e.body}" : ""
      UI.user_error!("Upload failed, edit discarded: #{e.message}#{detail}")
    end
  end

  desc "Show every Play Console track and the release(s) on it (read-only, throwaway edit). Closed testing is the `alpha` track unless a custom-named closed track exists."
  lane :track_status do
    service = play_service
    edit = service.insert_edit(package_name)
    begin
      service.list_edit_tracks(package_name, edit.id).tracks.each do |t|
        (t.releases || []).each do |r|
          UI.message("#{t.track}: versionCodes #{r.version_codes.inspect} — #{r.status} (#{r.name})")
        end
      end
    ensure
      service.delete_edit(package_name, edit.id)
    end
  end

  desc "Promote an already-uploaded versionCode to another track without re-uploading the AAB. Pass version_code:, to: (alpha = closed testing), optionally from: (default internal, used only to sanity-check the code is live there) and notes:."
  lane :promote_release do |options|
    code = (options[:version_code] or UI.user_error!("Pass version_code:")).to_s
    to = options[:to] or UI.user_error!("Pass to: internal|alpha|beta|production")
    from = options[:from] || "internal"

    service = play_service
    edit = service.insert_edit(package_name)
    begin
      source = service.get_edit_track(package_name, edit.id, from)
      live = (source.releases || []).flat_map { |r| r.version_codes || [] }.map(&:to_s)
      UI.user_error!("versionCode #{code} is not on the #{from} track (found #{live.inspect})") unless live.include?(code)

      release = Google::Apis::AndroidpublisherV3::TrackRelease.new(
        name: "versionCode #{code}",
        status: "completed",
        version_codes: [code],
        release_notes: options[:notes] ? [Google::Apis::AndroidpublisherV3::LocalizedText.new(language: options[:notes_locale] || "en-IN", text: options[:notes])] : nil
      )
      service.update_edit_track(package_name, edit.id, to, Google::Apis::AndroidpublisherV3::Track.new(track: to, releases: [release]))
      service.commit_edit(package_name, edit.id)
      UI.success("versionCode #{code} promoted from #{from} to #{to}")
    rescue => e
      service.delete_edit(package_name, edit.id) rescue nil
      detail = e.respond_to?(:body) ? " — #{e.body}" : ""
      UI.user_error!("Promotion failed, edit discarded: #{e.message}#{detail}")
    end
  end

  desc "Read-only: validate (not commit) a draft production release for a versionCode, to surface missing content rating/data safety/pricing blockers before actually promoting. Pass version_code:."
  lane :validate_production_release do |options|
    code = (options[:version_code] or UI.user_error!("Pass version_code:")).to_s
    service = play_service
    edit = service.insert_edit(package_name)
    begin
      release = Google::Apis::AndroidpublisherV3::TrackRelease.new(
        name: "versionCode #{code}",
        status: "completed",
        version_codes: [code]
      )
      service.update_edit_track(package_name, edit.id, "production", Google::Apis::AndroidpublisherV3::Track.new(track: "production", releases: [release]))
      service.validate_edit(package_name, edit.id)
      UI.success("Validation passed — no blockers found for a production release of versionCode #{code}")
    rescue => e
      detail = e.respond_to?(:body) ? e.body : e.message
      UI.error("Validation failed:")
      UI.error(detail)
    ensure
      service.delete_edit(package_name, edit.id)
    end
  end

  desc "Replace Play Store phone screenshots from a local folder, in filename order (Priority 2 screenshot redo — docs/Launch/09_testersCommunityreport.md)"
  lane :upload_screenshots do |options|
    locale = options[:locale] || "en-IN"
    source = options[:source] or UI.user_error!("Pass source: (folder of captioned PNGs; numeric filename prefixes set display order)")
    files = Dir.glob(File.join(source, "*.png")).sort
    UI.user_error!("No PNGs found in #{source}") if files.empty?

    service = play_service
    edit = service.insert_edit(package_name)
    begin
      service.deleteall_edit_image(package_name, edit.id, locale, "phoneScreenshots")
      files.each do |f|
        service.upload_edit_image(package_name, edit.id, locale, "phoneScreenshots", upload_source: f, content_type: "image/png")
        UI.message("Uploaded #{File.basename(f)}")
      end
      service.commit_edit(package_name, edit.id)
      UI.success("#{files.count} phone screenshots uploaded and committed for #{locale}")
    rescue => e
      service.delete_edit(package_name, edit.id)
      UI.user_error!("Screenshot upload failed, edit discarded: #{e.message}")
    end
  end
end
