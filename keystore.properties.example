# PayslipMax Android Release Signing Configuration Example
# Copy this file to `keystore.properties` (or set the equivalent environment variables)
#
# IMPORTANT: `keystore.properties` is listed in .gitignore and must NEVER be committed to Git.
#
# Environment variables with the same names (or prefixed with RELEASE_) can also be used in CI/CD:
# RELEASE_KEYSTORE_PATH, RELEASE_KEYSTORE_PASSWORD, RELEASE_KEY_ALIAS, RELEASE_KEY_PASSWORD

KEYSTORE_PATH=release.keystore
KEYSTORE_PASSWORD=your-keystore-password
KEY_ALIAS=payslipmax
KEY_PASSWORD=your-key-password
